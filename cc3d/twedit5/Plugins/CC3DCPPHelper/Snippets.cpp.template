=============== #@Menu@ Cell Operations

---------- #@Submenu@ Get Cell At Pixel
Point3D pt(X, Y, Z);
CellG *cell = cellFieldG->get(pt);

---------- #@Submenu@ Get Type Id From Name
Automaton *automaton = potts->getAutomaton();
unsigned char typeId = automaton->getTypeId("CELL_TYPE_NAME");

---------- #@Submenu@ Set Cell Type
Automaton *automaton = potts->getAutomaton();
cell->type = automaton->getTypeId("CELL_TYPE_NAME");

---------- #@Submenu@ Create Cell At Pixel
Point3D pt(X, Y, Z);
CellG *cell = potts->createCellG(pt);

---------- #@Submenu@ Create Cell With Explicit Spin
Point3D pt(X, Y, Z);
CellG *cell = potts->createCellGSpecifiedIds(pt, SPIN);

---------- #@Submenu@ Create Cell With Spin And Cluster
Point3D pt(X, Y, Z);
CellG *cell = potts->createCellGSpecifiedIds(pt, SPIN, CLUSTER_ID);

---------- #@Submenu@ Assign Type After Creation
Point3D pt(X, Y, Z);
CellG *cell = potts->createCellG(pt);
cell->type = potts->getAutomaton()->getTypeId("CELL_TYPE_NAME");

---------- #@Submenu@ Fill Box With Cell
Point3D seedPt(X0, Y0, Z0);
Point3D fillPt;
CellG *cell = potts->createCellG(seedPt);

for (fillPt.z = Z0; fillPt.z <= Z1; ++fillPt.z)
    for (fillPt.y = Y0; fillPt.y <= Y1; ++fillPt.y)
        for (fillPt.x = X0; fillPt.x <= X1; ++fillPt.x) {
            cellFieldG->set(fillPt, cell);
        }

---------- #@Submenu@ Create Cell And Run Steppers
Point3D pt(X, Y, Z);
CellG *cell = potts->createCellG(pt);
potts->runSteppers(); // useful when manual field updates should trigger VolumeTracker and related bookkeeping

---------- #@Submenu@ Set Pixel And Run Steppers
Point3D pt(X, Y, Z);
cellFieldG->set(pt, cell);
potts->runSteppers(); // useful after direct field writes outside copy attempts

