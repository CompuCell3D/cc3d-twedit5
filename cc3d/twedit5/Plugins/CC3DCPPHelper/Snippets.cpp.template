=============== #@Menu@ Setup

---------- #@Submenu@ Potts / Cell Field / Dim
Potts3D *potts = simulator->getPotts();
WatchableField3D<CellG *> *cellFieldG = (WatchableField3D<CellG *> *)potts->getCellFieldG();
if (!cellFieldG) {
    throw CC3DException("Cell field cannot be null");
}
Dim3D fieldDim = cellFieldG->getDim();

---------- #@Submenu@ Common Cached Pointers
potts = simulator->getPotts();
cellFieldG = (WatchableField3D<CellG *> *)potts->getCellFieldG();
cellInventoryPtr = &potts->getCellInventory();
boundaryStrategy = BoundaryStrategy::getInstance();
automaton = potts->getAutomaton();
xmlData = _xmlData;

---------- #@Submenu@ Neighbor Order Setup
boundaryStrategy = BoundaryStrategy::getInstance();
unsigned int maxNeighborIndex = boundaryStrategy->getMaxNeighborIndexFromNeighborOrder(NEIGHBOR_ORDER);

---------- #@Submenu@ Store XML And Register Steerable
xmlData = _xmlData;
simulator->registerSteerableObject(this);

---------- #@Submenu@ Preload Plugin
// This code is usually called from init
bool pluginAlreadyRegisteredFlag;
Plugin *plugin = Simulator::pluginManager.get("PLUGIN_NAME", &pluginAlreadyRegisteredFlag);
if (!pluginAlreadyRegisteredFlag)
    plugin->init(simulator);

---------- #@Submenu@ Register Energy Function
potts->registerEnergyFunctionWithName(this, toString());

---------- #@Submenu@ Register Cell Change Watcher
potts->registerCellGChangeWatcher(this);

---------- #@Submenu@ Register Fixed Steppers
potts->registerStepper(this);

=============== #@Menu@ Visit

---------- #@Submenu@ All Cells
CellInventory::cellInventoryIterator cInvItr;
CellG *cell = 0;

for (cInvItr = cellInventoryPtr->cellInventoryBegin(); cInvItr != cellInventoryPtr->cellInventoryEnd(); ++cInvItr) {
    cell = cellInventoryPtr->getCell(cInvItr);
    // Put your code here
    cerr << "cell id=" << cell->id << endl;
}

---------- #@Submenu@ Pixel Neighbors
Neighbor neighbor;
CellG *nCell = 0;
Point3D pt;

for (unsigned int nIdx = 0; nIdx <= maxNeighborIndex; ++nIdx) {
    neighbor = boundaryStrategy->getNeighborDirect(const_cast<Point3D &>(pt), nIdx);
    if (!neighbor.distance) {
        // if distance is 0 then the neighbor returned is invalid
        continue;
    }
    nCell = cellFieldG->get(neighbor.pt);

    if (nCell) {
        cerr << "neighbor pixel cell id=" << nCell->id << endl;
    }
}

---------- #@Submenu@ Cell Pixels Matching Cell
Neighbor neighbor;
CellG *nCell = 0;
Point3D pt;

for (unsigned int nIdx = 0; nIdx <= maxNeighborIndex; ++nIdx) {
    neighbor = boundaryStrategy->getNeighborDirect(const_cast<Point3D &>(pt), nIdx);
    if (!neighbor.distance) {
        continue;
    }
    nCell = cellFieldG->get(neighbor.pt);
    if (nCell != cell) {
        continue;
    }

